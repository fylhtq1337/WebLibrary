 
@{
    ViewData["Title"] = "Управление записями";
}

<h1>Управление записями</h1>

 
<hr />

<!-- Таблица существующих записей -->
@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead>
        <tr>
            <th>ID</th>
            <th>Книга</th>
            <th>Пользователь</th>
            <th>Дата взятия</th>
            <th>Дата возврата</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var record in Model)
        {
            <tr>
                <td>@record.Id</td>
                <td>@record.BookTitle</td>
                <td>@record.UserName</td>
                <td>@record.BorrowDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (record.ReturnDate.HasValue)
                    {
                        @record.ReturnDate.Value.ToString("yyyy-MM-dd")
                    }
                    else
                    {
                        <span class="text-danger">Не возвращено</span>
                    }
                </td>
                <td>
                    <!-- Кнопка для удаления записи -->
                    <form asp-action="DeleteBorrowRecord" asp-controller="Admin" asp-route-id="@record.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                    </form>
                    <!-- Кнопка для возврата книги -->
                    <form asp-action="ReturnBook" asp-controller="Admin" method="post" style="display:inline; margin-left: 10px;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@record.Id" />
                        <input type="date" name="returnDate" class="form-control" style="display:inline-block; width:auto;" />
                        <button type="submit" class="btn btn-success btn-sm">Вернуть</button>
                    </form>
                    
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>Записи о заимствованиях отсутствуют.</p>
}