@model IEnumerable<WebLibrary4.Models.DTOs.BookResponseDto>
@{
    ViewData["Title"] = "Управление книгами";
}

<h3>Список книг</h3>

<!-- Поиск -->
<div class="my-5">
    <h2 class="text-center">Поиск книг</h2>
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <form class="d-flex" asp-action="SearchResults" asp-controller="Books" method="get">
                <input id="searchQuery" name="query" class="form-control me-2" type="search" placeholder="Введите название или автора книги..." aria-label="Search">
                <button id="searchButton" class="btn btn-outline-success" type="submit">Найти</button>
            </form>
        </div>
    </div>
</div>

 
<table class="table">
    <thead>
    <tr>
        <th>Название</th>
        <th>Описание</th>
        <th>Автор</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var book in Model)
    {
        <tr data-book-id="@book.Id">
            <td>@book.Title</td>
            <td class="book-description">@book.Description</td>
            <td>@book.Author</td>
            <td>
                <button class="btn btn-warning btn-sm edit-book-button" data-book-id="@book.Id">Редактировать</button>
                <button class="btn btn-danger btn-sm delete-book-button" data-book-id="@book.Id">Удалить</button>
                <button class="btn btn-primary btn-sm view-book-button" data-book-id="@book.Id">Посмотреть содержимое</button>
            </td>
        </tr>
    }
    
    </tbody>
</table>

<!-- Модальное окно для редактирования книги -->
<div id="editBookModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Редактировать книгу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <form id="editBookForm">
                     
                    <div class="form-group mb-3">
                        <label for="bookDescriptionInput">Описание</label>
                        <textarea id="bookDescriptionInput" class="form-control" rows="3"></textarea>
                    </div>
                     
                    <input type="hidden" id="editBookId">
                    <button type="button" class="btn btn-primary" id="saveBookChanges">Сохранить</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Подключение jQuery -->
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Удаление книги
            $(".delete-book-button").on("click", function () {
                const bookId = $(this).data("book-id");
                if (confirm("Вы уверены, что хотите удалить эту книгу?")) {
                    $.ajax({
                        url: `/api/books/delete-book/${bookId}`,
                        type: "DELETE",
                        success: function (response) {
                            alert("Книга успешно удалена.");
                            $(`tr[data-book-id=${bookId}]`).remove();
                        },
                        error: function (xhr) {
                            alert("Произошла ошибка при удалении книги.");
                            console.error(xhr.responseText);
                        }
                    });
                }
            });

            // Открытие модального окна для редактирования
            $(".edit-book-button").on("click", function () {
                const bookId = $(this).data("book-id");

                // Получение текущих данных книги
                $.ajax({
                    url: `/api/books/getId/${bookId}`, // BooksController.GetBookById
                    type: "GET",
                    success: function (data) {
                        $("#editBookId").val(data.id);
                        $("#bookTitleInput").val(data.title);
                        $("#bookDescriptionInput").val(data.description);
                        $("#bookAuthorInput").val(data.author);

                        // Открыть модальное окно
                        $("#editBookModal").modal("show");
                    },
                    error: function (xhr) {
                        alert("Не удалось загрузить данные книги.");
                        console.error(xhr.responseText);
                    }
                });
            });

            // Сохранение изменений
            $("#saveBookChanges").on("click", function () {
                const bookId = $("#editBookId").val();
                const updatedBook = {
                    id: bookId,
                    title: $("#bookTitleInput").val(),
                    description: $("#bookDescriptionInput").val(),
                    author: $("#bookAuthorInput").val()
                };

                $.ajax({
                    url: `/admin/edit-book/${bookId}`,
                    type: "POST",
                    data: updatedBook,
                    success: function () {
                        alert("Книга успешно обновлена.");
                        const row = $(`tr[data-book-id=${bookId}]`);
                        row.find("td").eq(0).text(updatedBook.title);
                        row.find(".book-description").text(updatedBook.description);

                        $("#editBookModal").modal("hide");
                    },
                    error: function (xhr) {
                        alert("Ошибка при обновлении книги.");
                        console.error(xhr.responseText);
                    }
                });
            });

            // Открытие содержимого книги для просмотра (ViewBookContent)
            $(".view-book-button").on("click", function () {
                const bookId = $(this).data("book-id");

                // Открытие содержимого книги
                $.ajax({
                    url: `/api/books/view-content-book/${bookId}`, // BooksController.ReadBook
                    type: "GET",
                    success: function (data) {
                        alert("Книга открыта. Сейчас будет произведено её отображение.");
                        window.open(`/api/books/view-content-book/${bookId}`, "_blank");
                    },
                    error: function (xhr) {
                        alert("Не удалось загрузить содержимое книги.");
                        console.error(xhr.responseText);
                    }
                });
            });

            // Добавление новой книги
            $("#addBookButton").on("click", function () {
                // Здесь можно вызвать другое модальное окно для добавления книги
                alert("TODO: Добавить функциональность добавления книги");
            });
        });
    </script>
}