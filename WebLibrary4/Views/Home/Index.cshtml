<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-4">
    <h1>Library Management</h1>
    <!-- Навигация -->
    <ul class="nav nav-tabs">
        <li class="nav-item"><a href="#clients-tab" class="nav-link active" data-bs-toggle="tab">Клиенты</a></li>
        <li class="nav-item"><a href="#books-tab" class="nav-link" data-bs-toggle="tab">Книги</a></li>
        <li class="nav-item"><a href="#borrow-records-tab" class="nav-link" data-bs-toggle="tab">Выдача книг</a></li>
    </ul>

    <!-- Контент для каждой вкладки -->
    <div class="tab-content mt-3">
        <div id="clients-tab" class="tab-pane fade show active">
            <h2>Клиенты</h2>
            <button class="btn btn-primary" id="load-clients">Загрузить клиентов</button>
            <table class="table" id="clients-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Имя</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="books-tab" class="tab-pane fade">
            <h2>Книги</h2>
            <button class="btn btn-primary" id="load-books">Загрузить книги</button>
            <table class="table" id="books-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Жанр</th>
                    <th>Описание</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="borrow-records-tab" class="tab-pane fade">
            <h2>Выдача книг</h2>
            <button class="btn btn-primary" id="load-borrow-records">Загрузить записи о выдаче</button>
            <table class="table" id="borrow-records-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Книга</th>
                    <th>Клиент</th>
                    <th>Дата выдачи</th>
                    <th>Дата возврата</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
<script src="app.js"></script>
</body>
</html>