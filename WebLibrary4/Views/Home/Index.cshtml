<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-4">
    <h1>Library</h1>
    <!-- Навигация -->
    <ul class="nav nav-tabs">
        <li class="nav-item"><a href="#borrow-records-tab" class="nav-link" data-bs-toggle="tab">Выдача книг</a></li>
        <li class="nav-item"><a href="#clients-tab" class="nav-link active" data-bs-toggle="tab">Клиенты</a></li>
        <li class="nav-item"><a href="#books-tab" class="nav-link" data-bs-toggle="tab">Книги</a></li>
     </ul>

    <!-- Контент для каждой вкладки -->
    <div class="tab-content mt-3">
        <div id="clients-tab" class="tab-pane fade show active">
            <h2>Клиенты</h2>
            <div id="search-clients">
                <h4>Поиск клиентов</h4>
                <div class="form-group">
                    <input type="text" id="search-client-name" class="form-control" placeholder="Введите имя клиента">
                </div>
                <button id="search-clients-btn" class="btn btn-primary mt-2">Найти</button>
            </div>

            <table id="clients-search-results" class="table mt-3" style="display: none;">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Роль</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
            <button class="btn btn-primary" id="load-clients">Список клиентов</button>
            <button class="btn btn-success" id="add-client-btn">Добавить клиента</button>
            <div class="mt-3" id="add-client-form" style="display: none;">
                <!-- Форма для добавления клиента -->
                <h4>Новый клиент</h4>
                <div class="form-group">
                    <label for="client-name">Имя клиента:</label>
                    <input id="client-name" type="text" class="form-control" placeholder="Введите имя клиента">
                </div>
                <div class="form-group mt-2">
                    <label for="client-email">Email клиента:</label>
                    <input id="client-email" type="email" class="form-control" placeholder="Введите email клиента">
                </div>
                <button class="btn btn-primary mt-2" id="submit-client">Добавить</button>
            </div>
            <table class="table mt-3" id="clients-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="books-tab" class="tab-pane fade">
            <h2>Книги</h2>
            <div id="search-books">
                <h4>Поиск книг</h4>
                <div class="form-group">
                    <input type="text" id="search-title" class="form-control" placeholder="Название книги">
                </div>
                
                <button id="search-books-btn" class="btn btn-primary mt-2">Найти</button>
            </div>

            <table id="books-search-results" class="table mt-3">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Жанр</th>
                    <th>Год</th>
                </tr>
                </thead>
                <tbody>
                <!-- Данные будут рендериться динамически -->
                </tbody>
            </table>
            <button class="btn btn-primary" id="load-books">Открыть список книг</button>
            <button class="btn btn-success" id="add-book-btn" style="margin-left: 10px;">Добавить книгу</button>
            <div class="mt-3" id="add-book-form" style="display: none;">
                <h4>Новая книга</h4>
                <form>
                    <div class="form-group">
                        <label for="book-title">Название:</label>
                        <input id="book-title" type="text" class="form-control" placeholder="Введите название книги">
                    </div>
                    <div class="form-group mt-2">
                        <label for="book-description">Описание:</label>
                        <textarea id="book-description" class="form-control" placeholder="Введите описание"></textarea>
                    </div>
                    <div class="form-group mt-2">
                        <label for="book-author">Автор:</label>
                        <input id="book-author" type="text" class="form-control" placeholder="Введите имя автора">
                    </div>
                    <div class="form-group mt-2">
                        <label for="book-genre">Жанр:</label>
                        <input id="book-genre" type="text" class="form-control" placeholder="Введите жанр">
                    </div>
                    <div class="form-group mt-2">
                        <label for="book-year">Год издания:</label>
                        <input id="book-year" type="number" class="form-control" placeholder="Введите год издания">
                    </div>
                    <div class="form-group mt-2">
                        <label for="book-amount">Количество:</label>
                        <input id="book-amount" type="number" class="form-control" placeholder="Введите количество экземпляров книги">
                    </div>
                    @* <div class="form-group mt-2"> *@
                    @*     <label for="book-pdf">Файл PDF:</label> *@
                    @*     <input id="book-pdf" type="file" class="form-control-file" accept="application/pdf"> *@
                    @* </div> *@
                    
                    <button class="btn btn-success mt-3" id="submit-book">Добавить книгу</button>
                </form>
            </div>
             <table class="table" id="books-table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Жанр</th>
                    <th>Описание</th>
                    <th>Год</th>
                    <th>Количество</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="borrow-records-tab" class="tab-pane fade">
            <h2>Выдача книг</h2>
            <div id="search-borrow-records-form" class="mt-4">
                <h4>Поиск записей выдачи</h4>
                <form class="row g-3">
                    <!-- Форма поиска по книге -->
                    <div class="col-md-6">
                        <label for="search-book-title" class="form-label">Название книги:</label>
                        <input id="search-book-title" type="text" class="form-control" placeholder="Введите название книги">
                        <button class="btn btn-primary mt-2" type="button" id="search-records-by-book">Искать по книге</button>
                    </div>

                    <!-- Форма поиска по клиенту -->
                    <div class="col-md-6">
                        <label for="search-client-name" class="form-label">Имя клиента:</label>
                        <input id="search-client-names" type="text" class="form-control" placeholder="Введите имя клиента">
                        <button class="btn btn-primary mt-2" type="button" id="search-records-by-client">Искать по клиенту</button>
                    </div>
                </form>
            </div>
            <table class="table mt-3" id="search-results-table">
                <thead>
                <tr>
                    <th>Имя Клиента</th>
                    <th>Название Книги</th>
                    <th>Дата Выдачи</th>
                    <th>Дата Возврата</th>
                </tr>
                </thead>
                <tbody>
                <!-- Результаты поиска будут добавлены динамически -->
                </tbody>
            </table>
            <div id="add-borrow-record-form" style="display: none;" class="mt-3">
                <h4>Новая запись выдачи книги</h4>
                <form>
                    <div class="form-group">
                        <label for="borrow-client">Выберите клиента:</label>
                        <select id="borrow-client" class="form-control">
                            <option value="">-- Выберете клиента --</option>
                        </select>
                    </div>
                    <div class="form-group mt-2">
                        <label for="borrow-book">Выберите книгу:</label>
                        <select id="borrow-book" class="form-control">
                            <option value="">-- Выберите книгу --</option>
                        </select>
                    </div>
                    <div class="form-group mt-2">
                        <label for="borrow-date">Дата выдачи:</label>
                        <input id="borrow-date" type="date" class="form-control">
                    </div>
                    <button class="btn btn-success mt-3" id="submit-borrow-record">Создать запись</button>
                </form>
            </div>

            <button class="btn btn-success" id="add-borrow-record-btn">Создать запись выдачи</button>
            <button class="btn btn-primary" id="load-borrow-records">Показать список  записей о выдаче</button>
            <table class="table" id="borrow-records-table">
                <thead>
                <tr>
                    <th>Имя Клиента</th>
                    <th>Название Книги</th>
                    <th>Дата выдачи</th>
                    <th>Дата возврата</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
            
        </div>
    </div>
</div>
<script src="site.js"></script>
 
</body>
</html>